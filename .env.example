# --- Requeridas -------------------------------------------------------------

# Connection string de Postgres (Neon). Usa una branch de desarrollo, nunca la
# base de producción: todo lo que pruebes queda guardado ahí.
DATABASE_URL=

# Firma las sesiones (JWT). Cualquier cadena aleatoria larga, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# URL pública de la app. También arma el redirect de OAuth de Google Calendar.
AUTH_URL=http://localhost:3000

# --- Opcionales -------------------------------------------------------------
# Descoméntalas solo si les vas a dar un valor: env.ts rechaza una variable
# opcional definida pero vacía.

# Correos (Resend): confirmación/cancelación de reservas, recuperar contraseña,
# verificar correo. Sin la key no se envía ningún correo y el resto funciona.
# RESEND_API_KEY=
# Remitente; sin definirla se usa onboarding@resend.dev.
# EMAIL_FROM_ADDRESS=

# Subida de imágenes (logo, portada, portafolio, fotos de opiniones y de
# referencia) con Vercel Blob. Sin el token, subir imágenes falla.
# BLOB_READ_WRITE_TOKEN=

# Sincronización con Google Calendar (SPEC 17). Si defines GOOGLE_CLIENT_ID,
# CALENDAR_TOKEN_KEY es obligatoria: cifra los refresh tokens guardados.
# Generar la key (32 bytes en base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CALENDAR_TOKEN_KEY=

# Contraseña de las cuentas del seed (npm run db:seed). Sin definirla se genera
# una aleatoria y se imprime una sola vez.
# SEED_PASSWORD=
